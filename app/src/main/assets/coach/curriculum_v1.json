  "A1": {
   "nodeId": "A1",
   "timingSourceNote": "PLACEHOLDER timings — reconstructed from the design spec, not yet measured from the real game.",
   "theory": {
    "headlineEn": "Touch Input Grammar & Buffering",
    "summaryFa": "بازی سه ورودی لمسی پایه دارد: ضربه (TAP) برای فشار و رهای فوری، نگه‌داشتن (HOLD) برای فشارِ حداقل ۱۲۰ میلی‌ثانیه، و فلیک جهت‌دار (SWIPE) برای حرکت سریع انگشت در یک جهت. موتور بازی آخرین ورودی معتبر را تا ۲۰۰ میلی‌ثانیه (۱۲ فریم) بافر می‌کند؛ یعنی می‌توانی ورودی قدم بعدی را کمی زودتر بزنی تا دقیقاً در اولین فریم ممکن اجرا شود. اما در هر پنجره فقط اولین ورودی پذیرفته می‌شود و ضربه‌های اضافه اسلات بافر را هدر می‌دهند.",
    "ifConditionFa": "اگر می‌خواهی قدم بعدی کومبو در اولین فریم ممکن اجرا شود،",
    "thenActionFa": "آن را در پنجره‌ی لغو (Cancel Window) دویست میلی‌ثانیه‌ایِ حرکت قبلی وارد کن.",
    "neverRuleFa": "هرگز در یک پنجره‌ی ورودی بیش از یک بار ضربه نزن؛ ضربه‌های اضافه نادیده گرفته می‌شوند و ریتم کومبو را می‌شکنند.",
    "keyTerms": [
     {
      "termEn": "Input Buffer",
      "definitionFa": "صف کوتاه ۲۰۰ میلی‌ثانیه‌ای که ورودی زودهنگام تو را نگه می‌دارد تا در اولین فریم ممکن اجرا شود."
     },
     {
      "termEn": "Cancel Window",
      "definitionFa": "بخش پایانی ریکاوری که در آن حرکت بعدی یا غلت می‌تواند حرکت فعلی را قطع کند."
     },
     {
      "termEn": "Mash Penalty",
      "definitionFa": "جریمه‌ی ضربه‌های اضافه: ورودی‌های تکراری اسلات بافر را پر می‌کنند و قدم بعدی از دست می‌رود."
     },
     {
      "termEn": "Flick",
      "definitionFa": "کشیدن سریع انگشت در یک جهت؛ برای حرکت‌های جهت‌دار و اسپشال‌ها."
     }
    ],
